{
  "name": "kova-erp-monorepo-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Kova ERP — 8-repo polyrepo development workspace",
  "workspaces": [
    "kova-contracts",
    "kova-auth",
    "kova-sync",
    "kova-sale",
    "kova-inventory",
    "kova-accounting"
  ],
  "scripts": {
    "setup": "bash setup.sh",
    "typecheck:all": "node scripts/run-all.mjs typecheck",
    "test:all": "node scripts/run-all.mjs test",
    "build:all": "node scripts/run-all.mjs build",
    "infra:up": "cd kova-infra && docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "cd kova-infra && docker compose -f docker-compose.dev.yml down -v"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
